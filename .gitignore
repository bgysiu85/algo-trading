# NOTE ON SYNTAX
# A '#' only starts a comment at the START of a line. A '#' after a pattern is
# NOT a comment -- it becomes part of the pattern, which then matches nothing
# and the file is silently tracked. Keep every comment on its own line.

# --- environment -----------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo

# --- credentials: never, under any circumstances ---------------------------
# op:// references are pointers and are safe in source. Resolved VALUES are not.
credentials.json
tz_credentials.json
.env
*.pem
*.key

# --- runtime output and real trading history -------------------------------
# Excluded for privacy as much as for noise: these are actual fills and actual
# positions, not test fixtures.
var/
archive/
mcl_fills_*.csv
backtest_run_*.log
backtest_state*.json
# glob, not the literal name: renamed copies like
# "backtest_trades_1st attempt.csv" are still run output.
backtest_trades*.csv

# Session-scoped, rewritten daily by the trader and the scanner.
watchlist.txt
watchlist_blocked.txt

# Derived from broker statements -- real trading activity.
# Regenerate with: python -m common.build_pairs --ibkr <file> --tradezero <file>
traded_pairs.json

# --- large regenerable artefacts -------------------------------------------
# scanner_parameters.xml is 1.8 MB; regenerate it with
# python -m brokers.ibkr.scan_params
scanner_parameters.xml

# Cached IB bars -- ~11 MB, regenerated by common/backtest.py on demand.
# Also a snapshot of IB's split-adjustment state at fetch time, so it is
# machine-local working data rather than something to share.
bar_cache/

# Databento pulls
*.dbn.zst
*.dbn

# Bundles used to move commits between the sandbox and this machine.
*.bundle

# Files delivered from a Claude cloud session and saved into the repo root.
# The bundle itself is already covered by *.bundle above, but the reports and
# CSVs alongside it are not, and neither is the folder. Note this is INPUT
# staged for reading, not repo content -- the same reasoning as _backup*/
# below: a directory that arrives from outside should never be committed by a
# reflexive `git add -A`.
Claude outputs/
claude outputs/
Claude Outputs/

# --- editor / OS -----------------------------------------------------------
.pytest_cache/
.vscode/
.idea/
Thumbs.db
desktop.ini

# Superseded: both pulls now share bar_cache/, split into window
# subdirectories (2d_to_0930, 1d_to_2000). Kept so an older checkout or a
# stale working copy cannot commit one.
bars_cache/
data_pull_state*.json

# Local backup copies. A backup made INSIDE the repo that contains its own
# .git directory is recorded by `git add -A` as a gitlink (a submodule
# pointer) rather than as files -- it clones as an empty directory and has no
# .gitmodules entry. Keep backups outside the repo; this catches the mistake.
_backup*/
*_backup_*/
databento/
