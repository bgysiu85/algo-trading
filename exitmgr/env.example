# W15-0053 live exit manager settings (exitmgr/config.py). 4c copies these into the NAS compose service.
# DRY by default: the manager logs every order it would send and sends none.
# Paper needs BOTH lines changed by hand: XM_MODE=paper and XM_ACCOUNT=DU... (the paper account id).
# There is no live mode; live ports (4001, 4003, 7496, 7498) are refused.
XM_MODE=dry
XM_ACCOUNT=
XM_HOST=127.0.0.1
XM_PORT=4002
XM_CLIENT_ID=31
XM_CAPS=MCL:8,MNQ:2
XM_FLAT_MODE=FLAT
XM_FLAT_TIME=16:55
XM_EMERGENCY_MODE=A
XM_EMERGENCY_FALLBACK=B
XM_IGNORE_CLIENT_IDS=17
XM_OUT_DIR=/out/exit_manager
XM_RECONCILE_S=15
