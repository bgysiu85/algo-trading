# Copy to ".env" next to compose.yaml on the NAS (/volume1/docker/trader/) and fill in. ".env" is never committed.
# Lines starting with # are comments.

# --- Interactive Brokers PAPER login for the trader's Gateway (the paper username, NOT the live one and NOT the
#     data-only one the recorder uses). One IBKR username allows one session: close the PC's paper Gateway first.
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password

# Password for looking at the Gateway login screen over VNC (NAS-only; reach it with an SSH tunnel to port 5901)
VNC_SERVER_PASSWORD=choose_a_vnc_password
VNC_HOST_PORT=5901

# Folder for the Gateway's saved settings (create it first: sudo mkdir -p /volume1/trader/gateway)
GATEWAY_SETTINGS_DIR=/volume1/trader/gateway

# Pinned Gateway image: copy the SAME value the recorder uses, so both Gateways are the same version:
#   sudo grep '^IB_GATEWAY_IMAGE=' /volume1/docker/trade-journal/.env
# e.g. ghcr.io/gnzsnz/ib-gateway@sha256:...    Empty = follow the "stable" tag (changes without notice).
IB_GATEWAY_IMAGE=

# =====================================================================================================================
# THE TRADER (W10-0013 sub 5). Every line below is optional; the defaults are safe (a dry run, no orders).
# =====================================================================================================================
# dry = log signals, place NO orders.  paper = place real orders on the PAPER account (the cutover, sub 9).
TRADER_MODE=dry
# One value, comma-separated, no spaces: mcl  or  mcl,mc5   (run_paper.ps1's default is mcl)
TRADER_STRATEGY=mcl
# Empty = the trader's own default. Examples from the ProArt runs: 3 and strategy
TRADER_MAX_POSITIONS=
TRADER_CAP_SCOPE=
TRADER_TELEGRAM_BATCH_MIN=0
# on = the TradingView watchlist feed runs inside the trader (as run_paper.ps1 does); off = the watchlist is filled elsewhere
TRADER_FEED=on

# Folders on the NAS (create first, see NAS-TRADER-SETUP.md part 2)
TRADER_APP_DIR=/volume1/docker/trader/app
TRADER_DEPS_DIR=/volume1/docker/trader/deps
TRADER_VAR_DIR=/volume1/trader/var
# Image the trader runs in. Python 3.12 slim is what the recorder's packages were installed with.
TRADER_IMAGE=python:3.12-slim

# Secrets. Leave empty to leave that feature off. These are the same values the ProArt uses (1Password).
TV_SESSIONID=
TV_SESSIONID_SIGN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UI_RELAY_URL=
UI_AGENT_TOKEN=
UI_AGENT_ID=nas-trader
