# W11-0041 reminders sync. Copy to reminders.env (mode 600) or let make_reminders_env.sh write it. Never commit the real file.
REMINDERS_FEED_URL='https://...monday calendar feed link...'
MONDAY_API_TOKEN='<monday personal API token>'
CALDAV_PASSWORD='<password of the DSM user calendar-monday>'
CALDAV_USER='calendar-monday'
CALDAV_URL='https://siuds.synology.me:38443/caldav/'
# Connect to the NAS itself (127.0.0.1) but check the certificate against the public name above:
CALDAV_CONNECT_HOST='127.0.0.1'
CALDAV_TASK_LIST='monday reminders'
REMINDERS_BOARD_ID='5032297480'
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''
